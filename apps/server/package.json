{
  "name": "@brainforge/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./src/app.ts" },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist --external sharp --external bun:sqlite",
    "typecheck": "tsc -p .",
    "test": "bun test tests --pass-with-no-tests"
  },
  "dependencies": {
    "@brainforge/contracts": "workspace:*",
    "@brainforge/core": "workspace:*",
    "@brainforge/media": "workspace:*",
    "@brainforge/storage": "workspace:*",
    "hono": "^4.7.0"
  }
}
