{
  "name": "brainforge",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "recovery-smoke": "bun scripts/recovery-smoke.ts",
    "audit": "bun scripts/audit-operations.ts",
    "bf": "bun apps/cli/src/main.ts",
    "install-cli": "bun scripts/install-cli.ts",
    "server": "bun apps/server/src/index.ts",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "@brainforge/contracts": "workspace:*",
    "@brainforge/comfy": "workspace:*",
    "@brainforge/core": "workspace:*"
  }
}
